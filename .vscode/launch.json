{
    "version": "0.2.0",
    "configurations": [

        {
            // 等价于 streamlit run app.py --server.port 8501
            "name": "Streamlit-8501 - RAG前端全链路调试",
            "type": "python",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "app.py",
                "--server.port",
                "8501"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },

        {
            // 等价于app.py文件下的fastapi_app: uvicorn app:fastapi_app --host 0.0.0.0 --port 8000
            "name": "FastAPI-8000 - RAG后端API调试",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:fastapi_app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },

        {
            // 等价于app.py文件下的Gateway: uvicorn app:Gateway --host 0.0.0.0 --port 8001
            "name": "Gateway-8001 - 网关调试",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:gateway_app",
                "--host",
                "0.0.0.0",
                "--port",
                "8001"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }

    ]
}